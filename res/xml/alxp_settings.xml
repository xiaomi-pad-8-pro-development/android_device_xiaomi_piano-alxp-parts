<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/app_name">

    <Preference android:key="hero" android:selectable="false"
        app:layout="@layout/hero_preference"
        app:allowDividerAbove="false" app:allowDividerBelow="false" />

    <PreferenceCategory android:title="@string/category_apple">
        <Preference android:key="airpods_switching"
            app:layout="@layout/feature_card"
            app:allowDividerAbove="false" app:allowDividerBelow="false"
            android:icon="@drawable/ic_feature_airpods"
            android:title="@string/airpods_title" />
        <Preference android:key="iphone_notifications"
            app:layout="@layout/feature_card"
            app:allowDividerAbove="false" app:allowDividerBelow="false"
            android:icon="@drawable/ic_feature_iphone"
            android:title="@string/iphone_title" />
        <Preference android:key="mac_clipboard"
            app:layout="@layout/feature_card"
            app:allowDividerAbove="false" app:allowDividerBelow="false"
            android:icon="@drawable/ic_feature_clipboard"
            android:title="@string/mac_clipboard_title" />
        <Preference android:key="mac_display"
            app:layout="@layout/feature_card"
            app:allowDividerAbove="false" app:allowDividerBelow="false"
            android:icon="@drawable/ic_feature_mac"
            android:title="@string/mac_display_title" />
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="footer"
        android:title="@string/footer" />
</PreferenceScreen>
